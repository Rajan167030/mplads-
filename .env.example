# --- Postgres (used by docker-compose) ---
POSTGRES_USER=mplads
POSTGRES_PASSWORD=mplads
POSTGRES_DB=mplads
POSTGRES_PORT=5433

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://mplads:mplads@localhost:5433/mplads
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=dev-secret-change-me

# LLM provider abstraction — leave as "none" until a key is supplied.
# Supported: none | gemini | openai | groq
# Groq's lineup changes often — check `GET https://api.groq.com/openai/v1/models`
# with your key for what's currently available rather than trusting an old example.
# Groq example: LLM_PROVIDER=groq, LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
